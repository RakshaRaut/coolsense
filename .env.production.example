# Copy to .env.production and replace all CHANGE_ME values before deployment.
NODE_ENV=production
FRONTEND_PORT=80
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP_OR_DOMAIN

POSTGRES_USER=coolsense
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_URL_SAFE_RANDOM_VALUE
POSTGRES_DB=coolsense
DATABASE_URL=postgresql://coolsense:CHANGE_ME_USE_A_LONG_URL_SAFE_RANDOM_VALUE@database:5432/coolsense?schema=public

JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRES_IN=1d

TELEMETRY_INTERVAL_MS=5000
TELEMETRY_RETENTION_DAYS=365
ELECTRICITY_RATE_NPR_PER_KWH=30

# Keep disabled for the initial deployment.
THINGSBOARD_ENABLED=false
