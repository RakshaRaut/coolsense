NODE_ENV=development

PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=5173

POSTGRES_USER=coolsense_user
POSTGRES_PASSWORD=coolsense_password
POSTGRES_DB=coolsense_db
POSTGRES_PORT=5434

DATABASE_URL="postgresql://coolsense_user:coolsense_password@127.0.0.1:5434/coolsense_db?schema=public"
# Docker Compose uses this internal URL by default. Credentials in URLs must be percent-encoded.
DATABASE_URL_DOCKER="postgresql://coolsense_user:coolsense_password@database:5432/coolsense_db?schema=public"

JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="1d"

FRONTEND_URL="http://localhost:5173"

TELEMETRY_INTERVAL_MS=5000
# Days of Telemetry and SimulationSnapshot history to keep; older rows are purged hourly.
TELEMETRY_RETENTION_DAYS=365

# Use a tenant administrator account for virtual-device creation.
THINGSBOARD_ENABLED=false
# Use a URL reachable from the backend; in Docker, use the ThingsBoard service
# name and container port rather than localhost.
THINGSBOARD_URL=http://localhost:18080
# Docker Compose uses this address to reach ThingsBoard installed on the host.
# For a ThingsBoard container, use its Compose service name and internal port.
THINGSBOARD_DOCKER_URL=http://host.docker.internal:18080
THINGSBOARD_TENANT_ID=
THINGSBOARD_USER_ID=
THINGSBOARD_USERNAME=
THINGSBOARD_PASSWORD=